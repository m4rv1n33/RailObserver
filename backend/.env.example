# Database connection. These values match docker-compose.yml and work as they
# are for local development; use real credentials when hosting.
DB_URL=jdbc:postgresql://localhost:5432/railobserver
DB_USERNAME=railobserver
DB_PASSWORD=railobserver

# api token for open transport data
OTD_API_TOKEN=

# Shared PIN or passphrase that unlocks the app. Leave empty for local
# development: the API then stays open. It is required when the app runs with
# the prod profile. Do not reuse a code you use elsewhere, it is stored as is.
RAILOBSERVER_AUTH_PIN=

# Random value of at least 32 characters used to sign the session cookie.
# Generate one with:  openssl rand -base64 48
# Changing it invalidates all existing sessions and logs out every device.
RAILOBSERVER_AUTH_SECRET=

# Session cookies are HTTPS-only by default. Set to false only when testing the
# login over plain http.
RAILOBSERVER_AUTH_COOKIE_SECURE=true
