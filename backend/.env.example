# Database connection. These values match docker-compose.yml and work as they
# are for local development; use real credentials when hosting.
DB_URL=jdbc:postgresql://localhost:5432/railobserver
DB_USERNAME=railobserver
DB_PASSWORD=railobserver

# api token for open transport data
OTD_API_TOKEN=

# Which instance this is, shown in the app footer. Optional locally: unset, the
# app shows no such line. Required in a deployment, where both environments run
# on the same machine and nothing else tells them apart. SERVER_NAME is the
# machine (INTEGRA), ENVIRONMENT is prod or staging.
SERVER_NAME=
ENVIRONMENT=
