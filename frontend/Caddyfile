:8080 {
	encode gzip zstd

	header /sw.js Cache-Control "no-cache"
	header /registerSW.js Cache-Control "no-cache"
	# Strict-Transport-Security and a Content-Security-Policy are deliberately
	# absent: TLS terminates at the Cloudflare edge and this container only ever
	# speaks plain HTTP, so those two belong upstream. What is here is what this
	# container can meaningfully assert about its own responses.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	route {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.m4rv1n.dev
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}

		handle /api/* {
			reverse_proxy backend:8080
		}
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}