{
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode gzip zstd

	header /sw.js Cache-Control "no-cache"
	header /registerSW.js Cache-Control "no-cache"
	# Strict-Transport-Security and a Content-Security-Policy are deliberately
	# absent: TLS terminates at the Cloudflare edge and this container only ever
	# speaks plain HTTP, so those two belong upstream. What is here is what this
	# container can meaningfully assert about its own responses.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	route {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.m4rv1n.dev
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}

		handle /api/* {
			reverse_proxy backend:8080
		}
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}

	# Only fires for errors Caddy raises itself (e.g. 502 when the backend is
	# down). Responses proxied from Authelia or the backend pass through as-is.
	handle_errors {
		root * /srv/errors
		@known expression `{err.status_code} in [401, 403, 404, 502]`
		handle @known {
			rewrite * /{err.status_code}.html
			file_server
		}
		handle {
			rewrite * /error.html
			file_server
		}
	}
}