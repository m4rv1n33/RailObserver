# Deployment configuration for docker-compose.prod.yml. Copy it next to the
# compose file as .env, or keep one per environment (prod/.env, staging/.env)
# and select it with --env-file. Never commit a filled-in copy.
#
# Local development configures the backend through backend/.env instead; see
# backend/.env.example.

# Image tag to run. Defaults to latest, which is what the build workflow moves
# on every push to main. Pin a sha-<commit> tag to hold an environment on a
# known build, which is how staging is kept behind prod when testing.
TAG=latest

# Host port the frontend is published on, bound to 127.0.0.1 only. Give each
# environment its own, since both run on the same machine.
WEB_PORT=8080

# Database credentials. Postgres is created with these on first start and is
# not reachable from outside the compose network, but they are still the
# credentials to the data, so generate them rather than picking them.
DB_USERNAME=railobserver
DB_PASSWORD=

# API token for opentransportdata.swiss. Formation lookup is disabled without
# it and the rest of the app works.
OTD_API_TOKEN=

# Shared passphrase that unlocks the app. Required: the prod profile refuses to
# start without it. Use a passphrase rather than a numeric PIN, since a 4-digit
# PIN is 10000 possibilities and this instance is reachable from the internet.
RAILOBSERVER_AUTH_PIN=

# Random value of at least 32 characters signing the session cookie. Generate
# with:  openssl rand -base64 48
# Changing it logs out every device, which is also the only way to revoke a
# session. Prod and staging must have different ones.
RAILOBSERVER_AUTH_SECRET=

# Which instance this is. Shown in the app footer, and the only thing that tells
# the two deployments apart once they are both open in a browser. SERVER_NAME is
# the machine; ENVIRONMENT is prod or staging.
SERVER_NAME=INTEGRA
ENVIRONMENT=prod
